# Copy this file to the REPO ROOT as .env and fill in the values.
# Used by docker-compose.prod.yml — docker-compose.yml (dev) uses hardcoded values.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=testdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# ── API ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ── Mini App ──────────────────────────────────────────────────────────────────
# Public URL of the API — must be reachable from the user's browser
VITE_API_URL=https://api.yourdomain.com
