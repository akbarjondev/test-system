{
  "name": "test-system",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "docker:dev": "podman compose -f docker/docker-compose.yml up --build",
    "docker:dev:down": "podman compose -f docker/docker-compose.yml down",
    "docker:prod": "podman compose -f docker/docker-compose.prod.yml up --build -d",
    "docker:prod:down": "podman compose -f docker/docker-compose.prod.yml down",
    "docker:down": "podman compose -f docker/docker-compose.yml down",
    "docker:postgres": "podman compose -f docker/docker-compose.yml up postgres"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}