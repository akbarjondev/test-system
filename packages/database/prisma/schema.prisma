generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String       @id @default(cuid())
  email      String       @unique
  password   String
  role       Role         @default(STUDENT)
  createdAt  DateTime     @default(now())
  tests      Test[]
  testAttempts TestAttempt[]
  
  @@map("users")
}

model Test {
  id          String       @id @default(cuid())
  title       String
  description String?
  score    Float?       // Maximum possible score for per question test
  createdById String
  createdAt   DateTime     @default(now())
  createdBy   User         @relation(fields: [createdById], references: [id])
  questions   Question[]
  attempts    TestAttempt[]
  
  @@map("tests")
}

model Question {
  id        String   @id @default(cuid())
  testId    String
  text      String
  options   Option[]
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@map("questions")
}

model Option {
  id          String   @id @default(cuid())
  questionId  String
  text        String
  isCorrect   Boolean  @default(false)
  order       Int      // For maintaining option order (0, 1, 2, 3...)
  explanation String?  // Optional explanation for this option
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@unique([questionId, order]) // Ensure unique order per question
  @@map("options")
}

model TestAttempt {
  id              String          @id @default(cuid())
  testId          String
  studentId       String
  startedAt       DateTime        @default(now())
  submittedAt     DateTime?
  score           Float?
  questionOrders  QuestionOrder[] // Shuffled order of questions for this attempt
  answers         Answer[]        // Student's answers
  test            Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  student         User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  @@map("test_attempts")
}

model QuestionOrder {
  id            String       @id @default(cuid())
  attemptId     String
  questionId    String
  displayOrder  Int          // Shuffled order (0, 1, 2, 3...)
  attempt       TestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  
  @@unique([attemptId, displayOrder]) // Ensure unique display order per attempt
  @@unique([attemptId, questionId])   // Each question appears once per attempt
  @@map("question_orders")
}

model Answer {
  id            String      @id @default(cuid())
  attemptId     String
  questionId    String
  optionId      String?     // Selected option (null if unanswered)
  pointsEarned  Float       @default(0) // Points earned for this answer (0 if wrong, full points if correct)
  answeredAt    DateTime    @default(now())
  attempt       TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  
  @@unique([attemptId, questionId]) // One answer per question per attempt
  @@map("answers")
}

enum Role {
  ADMIN
  STUDENT
}